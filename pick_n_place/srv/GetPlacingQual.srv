# Service to obtain placing quality of a placed object
# object_name serves must be from the list CLOTH_SIZE. Serves to get the object size
# grasped_edge can be "short" or "long". Indicates the edge from which is grasped to create the canonical and grid divisions accordingly
# piling indicates if the object is the first placed or it is being piled (on top of another object), necessary as reference for placing quality
# n_obj_in_pile indicates the objects in the pile to be evaluated, including the currently placed object

string object_name
string layers
string grasped_edge
int64 n_objs_pile=1
---
float32 placing_quality